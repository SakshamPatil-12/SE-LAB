DC MOTOR

int EN = 11;   // Enable pin to control motor speed
int IN1 = 13;  // Input pin 1 to control motor direction
int IN2 = 12;  // Input pin 2 to control motor direction

void setup() {
  // Set all motor driver pins as OUTPUT
  pinMode(EN, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
}

void loop() {

  // Rotate the motor in Direction 1 (Clockwise)
  digitalWrite(IN1, HIGH);  // Set IN1 HIGH
  digitalWrite(IN2, LOW);   // Set IN2 LOW
  analogWrite(EN, 255);      // Turn ON motor at full speed

  delay(3000);              // Run motor for 3 seconds

  // Stop the motor
  analogWrite(EN, 0);        // Set motor speed to zero

  delay(1000);              // Wait for 1 second

  // Rotate the motor in Direction 2 (Anticlockwise)
  digitalWrite(IN1, LOW);   // Set IN1 LOW
  digitalWrite(IN2, HIGH);  // Set IN2 HIGH
  analogWrite(EN, 255);     // Turn ON motor at full speed

  delay(3000);              // Run motor for 3 seconds

  // Stop the motor
  analogWrite(EN, 0);       // Set motor speed to zero

  delay(1000);              // Wait for 1 second
}


ULTRASONIC 

const int sensorPin = 9;  // Ultrasonic sensor SIG pin connected to pin 9
const int ledPin = 5;     // LED connected to PWM pin 5

long duration;       // Stores the time taken by ultrasonic sound
float distance;      // Stores the calculated distance in cm
int brightness;      // Stores the LED brightness value

void setup()
{
  // Set sensor and LED pins
  pinMode(sensorPin, OUTPUT);
  pinMode(ledPin, OUTPUT);

  // Start serial communication at 9600 baud rate
  Serial.begin(9600);
}

void loop()
{
  // Send ultrasonic trigger pulse
  pinMode(sensorPin, OUTPUT);  // Set sensor pin as OUTPUT
  digitalWrite(sensorPin, LOW); // Keep signal LOW
  delayMicroseconds(2);         // Wait for 2 microseconds

  digitalWrite(sensorPin, HIGH); // Send HIGH trigger signal
  delayMicroseconds(10);        // Keep HIGH for 10 microseconds
  digitalWrite(sensorPin, LOW);  // Stop trigger pulse

  // Change sensor pin to INPUT to receive echo signal
  pinMode(sensorPin, INPUT);

  // Measure the time taken by the echo signal
  duration = pulseIn(sensorPin, HIGH);

  // Calculate distance in centimetres
  distance = duration * 0.0343 / 2;

  // Limit the measured distance between 10 cm and 100 cm
  distance = constrain(distance, 10, 100);

  // Convert distance into LED brightness
  // Near object = Bright LED, Far object = Dim LED
  brightness = map(distance, 10, 100, 255, 0);

  // Control LED brightness using PWM
  analogWrite(ledPin, brightness);

  // Display distance and brightness on Serial Monitor
  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.print(" cm, Brightness: ");
  Serial.println(brightness);

  // Wait for 200 milliseconds before repeating
  delay(200);
}

