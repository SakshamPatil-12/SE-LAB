SERVOMOTOR 

#include <Servo.h>

// Create a servo motor object
Servo myServo;

// Define potentiometer pin
int potPin = A0;  // Potentiometer connected to analog pin A0

// Declare variables
int potValue;  // Stores potentiometer reading
int angle;     // Stores servo motor angle

void setup() {
  // Connect servo motor signal wire to digital pin 9
  myServo.attach(9);

  // Start serial communication at 9600 baud rate
  Serial.begin(9600);
}

void loop() {
  // Read analog value from potentiometer (0 to 1023)
  potValue = analogRead(potPin);

  // Convert potentiometer value into servo angle (0 to 180 degrees)
  angle = map(potValue, 0, 1023, 0, 180);

  // Rotate servo motor to the calculated angle
  myServo.write(angle);

  // Display potentiometer value on Serial Monitor
  Serial.print("Potentiometer Value: ");
  Serial.print(potValue);

  // Display servo motor angle on Serial Monitor
  Serial.print("   Servo Angle: ");
  Serial.println(angle);

  // Wait for 100 milliseconds before repeating
  delay(100);
}

