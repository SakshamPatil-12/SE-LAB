POTENTIOMETOR

int potPin = A0;  // Potentiometer connected to analog pin A0
int ledPin = 9;   // LED connected to PWM pin 9

void setup() {
  // Set LED pin as OUTPUT
  pinMode(ledPin, OUTPUT);

  // Set potentiometer pin as INPUT
  pinMode(potPin, INPUT);

  // Start serial communication at 9600 baud rate
  Serial.begin(9600);
}

void loop() {
  // Read analog value from potentiometer (0 to 1023)
  int potValue = analogRead(potPin);

  // Convert potentiometer value (0-1023) into LED brightness (0-255)
  int ledBrightness = map(potValue, 0, 1023, 0, 255);

  // Control LED brightness using PWM
  analogWrite(ledPin, ledBrightness);

  // Display potentiometer reading on Serial Monitor
  Serial.println(potValue);

  // Wait for 500 milliseconds before repeating
  delay(500);
}


PHOTORESISTOR

int ldr = A0;  // LDR sensor connected to analog pin A0
int led = 9;   // LED connected to digital pin 9
int value;     // Variable to store LDR sensor reading

void setup() {
  // Set LED pin as OUTPUT
  pinMode(led, OUTPUT);

  // Start serial communication at 9600 baud rate
  Serial.begin(9600);
}

void loop() {
  // Read the light intensity value from LDR sensor
  value = analogRead(ldr);

  // Display LDR sensor value on Serial Monitor
  Serial.println(value);

  // Check whether the surrounding area is dark
  if (value < 500) {
    digitalWrite(led, HIGH);  // Turn ON LED in darkness
  } else {
    digitalWrite(led, LOW);   // Turn OFF LED in bright light
  }

  // Wait for 200 milliseconds before checking again
  delay(200);
}


PIR SENSOR 

const int pirPin = 2;  // PIR sensor output connected to pin 2
const int ledPin = 13; // LED connected to pin 13

void setup() {
  // Set PIR sensor pin as INPUT
  pinMode(pirPin, INPUT);

  // Set LED pin as OUTPUT
  pinMode(ledPin, OUTPUT);

  // Start serial communication at 9600 baud rate
  Serial.begin(9600);
}

void loop() {
  // Read the PIR sensor value
  int motion = digitalRead(pirPin);

  // Check whether motion is detected
  if (motion == HIGH) {
    digitalWrite(ledPin, HIGH);       // Turn ON LED
    Serial.println("Motion Detected!"); // Display motion detected message
  } 
  else {
    digitalWrite(ledPin, LOW);        // Turn OFF LED
    Serial.println("No Motion");      // Display no motion message
  }

  // Wait for 100 milliseconds before checking again
  delay(100);
}

TEMPERATURE
const int LM35 = A0;  // LM35 sensor connected to analog pin A0


const int greenLED = 3;   // Green LED connected to pin 3
const int yellowLED = 2;  // Yellow LED connected to pin 2
const int redLED = 1;     // Red LED connected to pin 1

void setup()
{
  // Set all LED pins as OUTPUT
  pinMode(greenLED, OUTPUT);
  pinMode(yellowLED, OUTPUT);
  pinMode(redLED, OUTPUT);

  // Start serial communication at 9600 baud rate
  Serial.begin(9600);
}

void loop()
{
  // Read temperature sensor analog value
  int sensorValue = analogRead(LM35);

  // Convert analog reading into voltage
  float voltage = sensorValue * (5.0 / 1023.0);

  // Convert voltage into temperature in Celsius
  // LM35 gives 10 mV voltage for every 1°C
  float temperature = voltage * 100.0;

  // Display temperature on Serial Monitor
  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" °C");

  // Turn OFF all LEDs before checking temperature
  digitalWrite(greenLED, LOW);
  digitalWrite(yellowLED, LOW);
  digitalWrite(redLED, LOW);

  // Check temperature and turn ON the appropriate LED
  if (temperature < 25)
  {
    digitalWrite(greenLED, HIGH);  // Green LED ON for low temperature
  }
  else if (temperature <= 35)
  {
    digitalWrite(yellowLED, HIGH); // Yellow LED ON for medium temperature
  }
  else
  {
    digitalWrite(redLED, HIGH);    // Red LED ON for high temperature
  }
}

